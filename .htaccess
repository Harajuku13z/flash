Options -Indexes
RewriteEngine On

# ── Sécurité ────────────────────────────────────────────────
# Bloquer accès direct au dossier includes
RewriteRule ^includes/ - [F,L]

# ── URLs propres sans .php ───────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# ── Routing clean ────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^conseils/([a-z0-9\-]+)/?$ conseils.php?slug=$1 [QSA,L]
RewriteRule ^offres/?$        offres.php       [QSA,L]
RewriteRule ^chauffeurs/?$    chauffeurs.php   [QSA,L]
RewriteRule ^proprietaires/?$ proprietaires.php [QSA,L]
RewriteRule ^conseils/?$      conseils.php     [QSA,L]
RewriteRule ^a-propos/?$      a-propos.php     [QSA,L]
RewriteRule ^contact/?$       contact.php      [QSA,L]
RewriteRule ^setup/?$         setup.php        [QSA,L]

# ── Compression Gzip ─────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# ── Cache navigateur ─────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
</IfModule>

# ── Headers sécurité ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
